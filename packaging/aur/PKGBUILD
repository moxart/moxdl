# Maintainer: Patrick Der Avakians <patrickderavakians at gmail dot com>
pkgname=moxdl
pkgver=1.8
pkgrel=1
pkgdesc="Fast, resumable, multi-connection download manager for the terminal"
arch=('any')
url="https://github.com/moxart/moxdl"
license=('MIT')
depends=('python')
optdepends=('wl-clipboard: --watch on Wayland'
            'xclip: --watch on X11'
            'libnotify: --notify desktop notifications')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # run updpkgsums after the v$pkgver tag exists; the AUR needs the real sum

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 mox.py "$pkgdir/usr/bin/mox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
